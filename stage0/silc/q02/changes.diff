 %%
+int hasCycle(struct Gsymbol *f);
+int walkCalls(struct tnode *t){
+    if(t == NULL) return 0;
+    if((t->nodetype == NODE_CALL || t->nodetype == NODE_METHOD) && t->Gentry != NULL){
+        if(hasCycle(t->Gentry)) return 1;
+    }
+    return walkCalls(t->left) || walkCalls(t->middle) || walkCalls(t->right);
+}
+int hasCycle(struct Gsymbol *f){
+    if(f->mark == 1) return 1;
+    if(f->mark == 2) return 0;
+    f->mark = 1;
+    int found = walkCalls(f->funcbody);
+    f->mark = 2;
+    return found;
+}
+void checkNoRecursion(void){
+    for(struct Gsymbol *g = Ghead; g != NULL; g = g->next) g->mark = 0;
+    for(struct Gsymbol *g = Ghead; g != NULL; g = g->next){
+        if(g->isFunction && hasCycle(g)){
+            printf("Error: recursion is not allowed (involving function %s)\n", g->name);
+            exit(1);
+        }
+    }
+}
 int treeDepth = 0;
