+struct tnode *makeSuperCallNode(char *mname, struct tnode *args){
+    struct Gsymbol *cf = GetCurrentFunction();
+    if(cf == NULL || cf->owner == NULL) typeErr("super used outside a method", "", "");
+    if(cf->owner->parent == NULL) typeErr("class '%s' has no parent class", cf->owner->name, "");
+    struct Memberfunclist *m = resolveMethod(cf->owner->parent, mname, args);
+    struct tnode *n = newNode(NODE_SUPER, m->type);
+    n->left = makeSelfNode();
+    n->right = args;
+    n->Gentry = m->func;
+    n->varname = strdup(mname);
     n->val = m->funcposition;
     return n;
 }
