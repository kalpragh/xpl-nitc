+    if(c == NULL) typeErr("unknown class '%s' in instanceof", cname, "");
+    struct tnode *n = newNode(NODE_INSTANCEOF, TYPE_BOOL);
+    n->left = var;
+    n->target = c->type;
+    return n;
+}
