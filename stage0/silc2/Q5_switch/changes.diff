+struct tnode *appendCase(struct tnode *chain, int v, struct tnode *body){
+    struct tnode *c = createtree(v, TYPE_NONE, NODE_CASE, NULL, body, NULL, NULL);
+    if(chain == NULL) return c;
+    struct tnode *q = chain;
+    while(1){
+        if(q->val == v){ printf("Error: duplicate case %d in switch\n", v); exit(1); }
+        if(q->right == NULL) break;
+        q = q->right;
+    }
+    q->right = c;
+    return chain;
+}
+struct tnode *makeSwitchNode(struct tnode *sel, struct tnode *cases, struct tnode *def){
+    if(sel->type != TYPE_INT){ printf("Type Mismatch: switch selector must be an int\n"); exit(1); }
+    return createtree(0, TYPE_NONE, NODE_SWITCH, NULL, sel, cases, def);
+}
+
 void noUserType(const char *what){
     if(isUserType(currentType)){ printf("Error: %s of a user-defined type are not supported\n", what); exit(1); }
 }
