+struct tnode *makeCopyNode(struct tnode *dest, struct tnode *src) {
+    if (!isUserType(dest->type) || dest->type->isClass) typeErr("copy() needs variables of a user-defined type", "", "");
+    if (dest->type != src->type) typeErr("copy() source and destination must have the same type", "", "");
+    struct tnode *n = newNode(NODE_COPY, dest->type);
+    n->left = dest;
+    n->right = src;
+    return n;
+}
