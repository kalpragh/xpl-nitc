+struct tnode *swapStmt(struct tnode *a, struct tnode *b){
+    if(a->type != TYPE_INT || b->type != TYPE_INT){
+        printf("Type Mismatch: swap() needs two int variables\n");
+        exit(1);
+    }
+    if(a->nodetype == 'V' && b->nodetype == 'V' && strcmp(a->varname, b->varname) == 0){
+        printf("Error: cannot swap a variable with itself\n");
+        exit(1);
+    }
+    struct tnode *s1 = createtree(0,TYPE_NONE,'=',NULL,a,NULL,createtree(0,TYPE_NONE,'+',NULL,a,NULL,b));
+    struct tnode *s2 = createtree(0,TYPE_NONE,'=',NULL,b,NULL,createtree(0,TYPE_NONE,'-',NULL,a,NULL,b));
+    struct tnode *s3 = createtree(0,TYPE_NONE,'=',NULL,a,NULL,createtree(0,TYPE_NONE,'-',NULL,a,NULL,b));
+    return createtree(0,TYPE_NONE,'C',NULL,s1,NULL,createtree(0,TYPE_NONE,'C',NULL,s2,NULL,s3));
+}
