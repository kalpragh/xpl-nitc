+struct tnode *oneNode(void){
+    return createtree(1, TYPE_INT, 'N', NULL, NULL, NULL, NULL);
+}
+struct tnode *updateStmt(struct tnode *lv, int op, struct tnode *rhs){
+    if(lv->type != TYPE_INT){
+        printf("Type Mismatch: the target of an update statement must be an int variable\n");
+        exit(1);
+    }
+    struct tnode *calc = createtree(0, TYPE_NONE, op, NULL, lv, NULL, rhs);
+    return createtree(0, TYPE_NONE, '=', NULL, lv, NULL, calc);
+}
