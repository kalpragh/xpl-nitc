Grammar

    0 $accept: Program $end

    1 Program: declarations START Slist END ';'

    2 declarations: DECL declList ENDDECL
    3             | DECL ENDDECL

    4 declList: declList declaration
    5         | declaration

    6 declaration: type varList ';'

    7 type: INT
    8     | STR

    9 varList: varList ',' ID '[' NUM ']'
   10        | varList ',' ID
   11        | ID '[' NUM ']'
   12        | ID

   13 Slist: Slist Stmt
   14      | Stmt

   15 Stmt: ID '=' Expr ';'
   16     | READ '(' ID ')' ';'
   17     | WRITE '(' Expr ')' ';'
   18     | IF '(' Expr ')' THEN Slist ELSE Slist ENDIF ';'
   19     | IF '(' Expr ')' THEN Slist ENDIF ';'
   20     | WHILE '(' Expr ')' DO Slist ENDWHILE ';'
   21     | BREAK ';'
   22     | CONTINUE ';'
   23     | REPEAT Slist UNTIL '(' Expr ')' ';'
   24     | DO Slist WHILE '(' Expr ')' ';'

   25 Expr: Expr '+' Expr
   26     | Expr '-' Expr
   27     | Expr '*' Expr
   28     | Expr '/' Expr
   29     | Expr '<' Expr
   30     | Expr '>' Expr
   31     | Expr LE Expr
   32     | Expr GE Expr
   33     | Expr EQ Expr
   34     | Expr NE Expr
   35     | '(' Expr ')'
   36     | NUM
   37     | ID


